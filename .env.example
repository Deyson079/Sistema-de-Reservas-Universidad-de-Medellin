# ── Base de datos (Supabase → Project Settings → Database → Connection string) ──
# Conexión con pooler (puerto 6543) para la app:
DATABASE_URL="postgresql://postgres.xxxx:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión directa (puerto 5432) para migraciones:
DIRECT_URL="postgresql://postgres.xxxx:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ── Firma las marcas propias (recuperación de contraseña): cadena aleatoria de 32+ caracteres ──
AUTH_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# URL pública de la app (para enlaces en correos)
APP_URL="http://localhost:3000"

# ── Correo ── "consola": los códigos de Supabase Auth no se envían, se muestran en pantalla y en la terminal (solo pruebas).
# "smtp": Supabase envía los códigos (configura su SMTP y plantillas) y la app envía el resto de correos con estos datos SMTP.
EMAIL_MODO="consola"
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_USER="deportes@udemedellin.edu.co"
SMTP_PASS=""
EMAIL_DESDE="Reservas Deportivas Universidad de Medellín <deportes@udemedellin.edu.co>"

# ── Supabase (Project Settings → API). Obligatorias: Auth maneja todas las cuentas y sesiones ──
SUPABASE_URL="https://TU-PROYECTO.supabase.co"
# Clave pública "anon" (o la "publishable" sb_publishable_...)
SUPABASE_ANON_KEY=""
# Clave secreta "service_role" (o la "secret" sb_secret_...). Solo en el servidor, nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=""
# Archivos (RUT y comprobantes) en Supabase Storage
SUPABASE_BUCKET="documentos"

# Opcional: protege /api/cron (Vercel Cron envía Authorization: Bearer CRON_SECRET)
CRON_SECRET=""

# Muestra el panel de cuentas de prueba en los ingresos (desactívalo en producción)
MODO_DEMO="true"
NEXT_PUBLIC_MODO_DEMO="true"
