# ── Base de datos (Supabase → Project Settings → Database → Connection string) ──
# Conexión con pooler (puerto 6543) para la app:
DATABASE_URL="postgresql://postgres.xxxx:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión directa (puerto 5432) para migraciones:
DIRECT_URL="postgresql://postgres.xxxx:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ── Sesiones: cadena aleatoria de 32+ caracteres (openssl rand -base64 32) ──
AUTH_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# URL pública de la app (para enlaces en correos)
APP_URL="http://localhost:3000"

# ── Correo ── "consola" muestra los códigos en pantalla y en la terminal (solo pruebas). "smtp" envía de verdad.
EMAIL_MODO="consola"
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_USER="deportes@udemedellin.edu.co"
SMTP_PASS=""
EMAIL_DESDE="Reservas Deportivas Universidad de Medellín <deportes@udemedellin.edu.co>"

# ── Archivos (RUT y comprobantes) en Supabase Storage. Si se dejan vacías, se guardan en public/uploads ──
SUPABASE_URL="https://qoseidizfcmvubwxzqwl.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="documentos"

# Muestra el panel de cuentas de prueba en los ingresos (desactívalo en producción)
MODO_DEMO="true"
NEXT_PUBLIC_MODO_DEMO="true"
